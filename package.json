    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
